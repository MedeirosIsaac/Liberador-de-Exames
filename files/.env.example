# Copie este arquivo para ".env" e preencha. NUNCA suba o ".env" para o GitHub
# (ele já está no .gitignore).

# String de conexão do Postgres (ex.: copiada do painel do Neon).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

PORT=5000

# Só no PRIMEIRO start, quando ainda não existe nenhum usuário:
# o servidor cria este administrador. Depois pode apagar ADMIN_SENHA.
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=

# Duração do login em horas (padrão: 12)
SESSAO_HORAS=12

# Só se o Chrome do Puppeteer não estiver no caminho padrão:
# PUPPETEER_EXECUTABLE_PATH=
